## which truth sets this run is allowed to use
def enabled(name):
    b = BENCHMARKS[name]
    if name.startswith("cmrg") and not config["cmrg"]:              return False
    if b["cls"] == "sv" and not config["structural_variants"]:      return False
    if b["cls"] == "tr" and not config["tandem_repeats"]:           return False
    return True

def cells():
    for cn, c in CALLERS.items():
        for bn, b in BENCHMARKS.items():
            if not enabled(bn):            continue
            if c["build"] != b["build"]:   continue
            if b["cls"] not in c["cls"]:   continue
            for en, kinds in ENGINES.items():
                if b["cls"] in kinds:
                    yield en, cn, bn

CELLS = list(cells())

wildcard_constraints:
    sample   = "|".join(re.escape(s) for s in sorted(samples, key=len, reverse=True)),
    caller   = "|".join(re.escape(c) for c in sorted(CALLERS, key=len, reverse=True)),
    truth    = "|".join(re.escape(t) for t in sorted(BENCHMARKS, key=len, reverse=True)),


## Gather the target output files (This defines which parts of the pipeline will be run)
def gather_targets():
    all_target = []
    for engine, caller, truth in CELLS:
        all_target.extend(expand(
            f"benchmarks/{engine}/{caller}/{truth}/{{sample}}/" + SUMMARY[engine],
            sample=samples))
        if engine == "truvari" and BENCHMARKS[truth].get("refine"):
            all_target.extend(expand(
                f"benchmarks/truvari/{caller}/{truth}/{{sample}}/refine.variant_summary.json",
                sample=samples))
    all_target.append("out/benchmarks/all_benchmarks.tsv")
    all_target.append("out/benchmarks/benchmark_matrix.tsv")
    if config["allelic_imbalance"]:
        for c in ALIB_CALLERS:
            all_target.append(f"allelic_imbalance/{c}/alib_vaf_summary.tsv")
            all_target.append(f"allelic_imbalance/{c}/alib_dropout.tsv")
            all_target.append(f"allelic_imbalance/{c}/alib_plots.pdf")
    return all_target

## Truvari trgt is not informative, since refine is used on top of it
NO_REPORT = {("truvari", "trgt", "tr_v1.0.1")}

## Which output files the benchmarking tools create, copy of gather_targets
def bench_files():
    out = []
    for engine, caller, truth in CELLS:
        for s in samples:
            if (engine, caller, truth) not in NO_REPORT:
                out.append((engine, caller, truth, s,
                            f"benchmarks/{engine}/{caller}/{truth}/{s}/"
                            + SUMMARY[engine].format(sample=s)))
            if engine == "truvari" and BENCHMARKS[truth].get("refine"):
                out.append(("truvari_refine", caller, truth, s,
                            f"benchmarks/truvari/{caller}/{truth}/{s}/refine.variant_summary.json"))
    return out

